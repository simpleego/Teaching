# 🟣 5단계: 프론트엔드에서 API 데이터 가져오기 (JavaScript)

HTML + JS 예시:

```html
<!DOCTYPE html>
<html>
<head>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

<canvas id="myChart"></canvas>

<script>
fetch("http://localhost:8000/chart-data")
  .then(response => response.json())
  .then(data => {

    const ctx = document.getElementById('myChart');

    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: data.labels,
        datasets: [{
          label: 'Sales',
          data: data.values
        }]
      }
    });

  });
</script>

</body>
</html>
```

